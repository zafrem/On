# Neon PostgreSQL connection string (pooled endpoint recommended for serverless).
# Get it from the Neon console → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/on?sslmode=require"

# Web Push (VAPID) — server-only. Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret the external scheduler must present to POST /api/cron/notifications (FR-R16).
CRON_SECRET=""
